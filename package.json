{
  "name": "unified-life-services",
  "version": "0.1.0",
  "private": true,
  "description": "India-first, globally expandable Unified Life Services Platform (Independent Public Services Guide)",
  "scripts": {
    "dev": "npm run build:catalogue && next dev",
    "build:catalogue": "node scripts/build-catalogue.mjs",
    "build": "npm run build:catalogue && next build",
    "start": "next start",
    "serve:static": "node scripts/static-server.mjs",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate:catalogue": "node scripts/validate-catalogue.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:links:offline": "node scripts/check-links.mjs --offline",
    "report:staleness": "node scripts/catalogue-staleness.mjs",
    "audit:perf": "node scripts/perf-budget.mjs",
    "audit:ci": "npm audit --audit-level=high",
    "docker:build": "docker build -t unified-life-services:latest .",
    "docker:verify": "node scripts/docker-verify.mjs"
  },
  "dependencies": {
    "minisearch": "^7.2.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.14.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "prettier": "^3.5.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.4"
  }
}
